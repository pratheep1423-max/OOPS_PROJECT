@model ReportFilterViewModel
@{
    ViewData["Title"] = "Attendance Reports";
}

<h4 class="mb-3">Attendance Reports</h4>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2">
            <div class="col-md-3">
                <label class="form-label">Department</label>
                <select name="department" class="form-select">
                    <option value="">All Departments</option>
                    @foreach (var dept in Model.Departments)
                    {
                        <option value="@dept" selected="@(Model.Department == dept)">@dept</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Year</label>
                <select name="year" class="form-select">
                    <option value="">All Years</option>
                    @for (int y = 1; y <= 5; y++)
                    {
                        <option value="@y" selected="@(Model.Year == y)">Year @y</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Section</label>
                <input type="text" name="section" value="@Model.Section" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">From Date</label>
                <input type="date" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">To Date</label>
                <input type="date" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-md-1 d-flex align-items-end">
                <button type="submit" class="btn btn-outline-primary w-100"><i class="bi bi-search"></i></button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Register Number</th>
                        <th>Name</th>
                        <th>Department</th>
                        <th>Total Working Days</th>
                        <th>Days Present</th>
                        <th>Days Absent</th>
                        <th>Attendance %</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Results.Any())
                    {
                        @foreach (var row in Model.Results)
                        {
                            <tr>
                                <td>@row.RegisterNumber</td>
                                <td>@row.StudentName</td>
                                <td>@row.Department</td>
                                <td>@row.TotalWorkingDays</td>
                                <td>@row.DaysPresent</td>
                                <td>@row.DaysAbsent</td>
                                <td>
                                    <span class="badge @(row.AttendancePercentage < 75 ? "bg-danger" : "bg-success")">
                                        @row.AttendancePercentage%
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No data available for the selected filters.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
