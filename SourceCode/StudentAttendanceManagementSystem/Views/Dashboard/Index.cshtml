@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card stat-card stat-card-primary">
            <div class="card-body">
                <div class="stat-icon"><i class="bi bi-people-fill"></i></div>
                <div class="stat-value">@Model.TotalStudents</div>
                <div class="stat-label">Total Students</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card stat-card-success">
            <div class="card-body">
                <div class="stat-icon"><i class="bi bi-check-circle-fill"></i></div>
                <div class="stat-value">@Model.PresentToday</div>
                <div class="stat-label">Present Today</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card stat-card-danger">
            <div class="card-body">
                <div class="stat-icon"><i class="bi bi-x-circle-fill"></i></div>
                <div class="stat-value">@Model.AbsentToday</div>
                <div class="stat-label">Absent Today</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card stat-card-info">
            <div class="card-body">
                <div class="stat-icon"><i class="bi bi-graph-up"></i></div>
                <div class="stat-value">@Model.TodayAttendancePercentage%</div>
                <div class="stat-label">Today's Attendance</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <i class="bi bi-clock-history"></i> Recent Attendance Records
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Register Number</th>
                        <th>Student Name</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Marked At</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentAttendanceRecords.Any())
                    {
                        @foreach (var record in Model.RecentAttendanceRecords)
                        {
                            <tr>
                                <td>@record.Student?.RegisterNumber</td>
                                <td>@record.Student?.StudentName</td>
                                <td>@record.AttendanceDate.ToString("dd-MMM-yyyy")</td>
                                <td>
                                    @if (record.Status == AttendanceStatus.Present)
                                    {
                                        <span class="badge bg-success">Present</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Absent</span>
                                    }
                                </td>
                                <td>@record.CreatedAt.ToLocalTime().ToString("dd-MMM-yyyy HH:mm")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">No attendance records yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
