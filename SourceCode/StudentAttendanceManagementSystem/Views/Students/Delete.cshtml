@model Student
@{
    ViewData["Title"] = "Delete Student";
}

<h4 class="mb-3 text-danger">Delete Student</h4>

<div class="card border-danger">
    <div class="card-body">
        <p>Are you sure you want to delete this student? This will also remove all of their attendance records.</p>
        <dl class="row">
            <dt class="col-sm-3">Register Number</dt>
            <dd class="col-sm-9">@Model.RegisterNumber</dd>

            <dt class="col-sm-3">Student Name</dt>
            <dd class="col-sm-9">@Model.StudentName</dd>

            <dt class="col-sm-3">Department</dt>
            <dd class="col-sm-9">@Model.Department</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="StudentId" />
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Confirm Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
