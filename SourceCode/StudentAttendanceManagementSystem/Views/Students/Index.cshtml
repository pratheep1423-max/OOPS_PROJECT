@model List<Student>
@{
    ViewData["Title"] = "Students";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Student Management</h4>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add Student
        </a>
    }
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2">
            <div class="col-md-4">
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name, register no., email" />
            </div>
            <div class="col-md-3">
                <select name="department" class="form-select">
                    <option value="">All Departments</option>
                    @foreach (var dept in (List<string>)ViewBag.Departments)
                    {
                        <option value="@dept" selected="@(ViewBag.Department == dept)">@dept</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="section" class="form-select">
                    <option value="">All Sections</option>
                    @foreach (var sec in (List<string>)ViewBag.Sections)
                    {
                        <option value="@sec" selected="@(ViewBag.Section == sec)">@sec</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="year" class="form-select">
                    <option value="">All Years</option>
                    @for (int y = 1; y <= 5; y++)
                    {
                        <option value="@y" selected="@(ViewBag.Year == y)">Year @y</option>
                    }
                </select>
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-outline-primary w-100"><i class="bi bi-search"></i></button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Register Number</th>
                        <th>Name</th>
                        <th>Department</th>
                        <th>Year</th>
                        <th>Section</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td>@s.RegisterNumber</td>
                                <td>@s.StudentName</td>
                                <td>@s.Department</td>
                                <td>@s.Year</td>
                                <td>@s.Section</td>
                                <td>@s.Email</td>
                                <td>@s.PhoneNumber</td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@s.StudentId" class="btn btn-sm btn-outline-secondary" title="View">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@s.StudentId" class="btn btn-sm btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@s.StudentId" class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">No students found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
